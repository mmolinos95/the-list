# Copy to .env.local for development. On Vercel, add these under
# Project → Settings → Environment Variables. See README.md for where each comes from.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Any long random strings. Generate with: openssl rand -base64 32
DROP_LINK_SECRET=
CRON_SECRET=

# Public address of the app, used in email links. No trailing slash.
# On Vercel it defaults to the production URL, so this is optional there.
SITE_URL=http://localhost:3000

# Club Gmail + an app password (Google Account → Security → App passwords).
# Leave empty in development: emails are printed to the terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
