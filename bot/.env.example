# Copy to bot/.env (never commit it). See bot/README.md for where each value comes from.

# Supabase → Project Settings → API Keys (the same project as the app)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DROP_LINK_SECRET=          # same value as the app's, so posted links work
SITE_URL=https://cbsfc-the-list.vercel.app

# Club Gmail + app password, only for the 6-digit linking codes and down alerts.
# Leave empty to print them to the terminal.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google AI Studio API key (free tier). GEMINI_MODEL is optional: models tried in
# order, the next taking over when one is overloaded or out of quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# Who gets an email when the bot is down: logged out, offline 10+ minutes, or
# crashed on start (at most one per kind per hour). Comma-separated; empty = no alerts.
ALERT_EMAILS=

BOT_PHONE=                 # E.164, the bot's own number (pairing + wa.me links)
ALLOWED_GROUPS=            # group IDs (…@g.us, from the "In N group(s)" log line at start), comma-separated. Exact names work too, but stop matching if the chat is renamed.
BOT_FEATURES=read          # any of: read,post,signup,board,ai
DATA_DIR=./data            # auth state + local db
